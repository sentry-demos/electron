# =============================================================================
# Empower Plant Electron — environment template
# =============================================================================
# Copy this file to `.env` and fill in real values.
# `.env` is gitignored — never commit real secrets.
# Rotate any value that ever lands in a commit, even briefly.
# =============================================================================

# ── Sentry: client-side ──────────────────────────────────────────────────────
# Full DSN — Sentry → [Project] → Settings → Client Keys (DSN)
# The ingest host and project ID are derived from this automatically.
# DSNs are public keys (safe to ship to clients) but tying them to a paid org
# means anyone with the DSN can send events on your bill — treat with care.
SENTRY_DSN=https://<public-key>@<org-id>.ingest.us.sentry.io/<project-id>

# Org and project slugs — used by the webpack plugin for source-map upload
SENTRY_ORG=<your-org-slug>
SENTRY_PROJECT=<your-project-slug>

# Release name — must be unique per build. Same string is sent with events
# and used to associate uploaded source maps. Bump for each new build.
SENTRY_RELEASE=empower-plant-electron@1.0.0

# Environment tag — production | staging | development
SENTRY_ENVIRONMENT=development

# ── Sentry: build-time only (SECRET) ─────────────────────────────────────────
# Auth token — Sentry → Settings → Auth Tokens
# Required scopes: project:read, project:releases, org:read
# Used ONLY by webpack at build time to upload source maps.
# NEVER commit. NEVER ship in the bundle. NEVER reuse across projects.
# If this token ever appears in a commit (even a placeholder file), revoke it.
SENTRY_AUTH_TOKEN=<your-auth-token>

# ── Backend services ─────────────────────────────────────────────────────────
# Hosted Empower backends — pick one, or run a local backend from the Empower repo.
# Flask (default):     https://flask.empower-plant.com
# Express:             https://express.empower-plant.com
# Spring Boot:         https://spring-boot.empower-plant.com
# ASP.NET Core:        https://aspnetcore.empower-plant.com
# Laravel:             https://laravel.empower-plant.com
# Ruby on Rails:       https://ruby-on-rails.empower-plant.com
BACKEND_URL=https://flask.empower-plant.com

# Agent service URL — for the AI chat widget
AGENT_URL=https://agent.empower-plant.com
